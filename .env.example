# Скопіюйте цей файл у .env (він у .gitignore) і впишіть свій ключ. Лапок і пробілів навколо ключа не потрібно.

# --- Для студентів: Google AI Studio (безкоштовно) ---
# Ключ створюється на https://aistudio.google.com/apikey
LAB_PROVIDER=gemini
GEMINI_API_KEY=

# --- Для викладача: Claude API (платно, окремо від підписки Claude Pro/Max) ---
# Ключ створюється на https://console.anthropic.com → API keys.
# LAB_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...

# Необов'язково: модель. За замовчуванням gemini-3.5-flash-lite / claude-sonnet-5-5.
# LAB_MODEL=gemini-3.5-flash-lite

# Пауза між запитами, мс, щоб не впертися в ~15 запитів/хв безкоштовного рівня Gemini
# (діє в циклах: лабораторна 1, крок 5; лабораторна 2, Step7; лабораторна 3 — перед кожним новим запитом). Для платного Claude можна поставити 0.
LAB_DELAY_MS=4000

# Необов'язково, лише Gemini: рівень «міркування» (minimal | low | medium | high) — експериментально
# LAB_THINKING_LEVEL=low

# --- Варіант (лабораторні 1–4) ---
# Ваш варіант: N = ((номер у журналі − 1) mod 8) + 1, тобто число від 1 до 8, наприклад LAB_VARIANT=3.
# Лаби 1–2 без нього беруть варіант 1 (дані до появи варіантів); лаба 3 без нього на справжній моделі не запуститься.
LAB_VARIANT=

# --- Лабораторна 3 ---
# temperature у лабі 3 не надсилається (значення моделі за замовчуванням). Рівні міркування кроку 4 (мінімальне / effort low / high)
# клієнт перекладає сам: Gemini 3+ — thinkingLevel, Claude 5.x — output_config.effort, Claude 4.x — thinking.budget_tokens.
# Необов'язково: бюджет effort high у токенах для моделей без effort (Gemini 2.x, Claude 4.x; Claude: мінімум 1024), за замовчуванням 4096:
# LAB_THINKING_BUDGET=4096
# Необов'язково: не читати й не писати кеш відповідей target/lab3-cache.json (тоді кожен прогін ≈75 запитів)
# LAB_NO_CACHE=1
# Необов'язково: пропустити бонусний крок 6 (−5 запитів)
# LAB_SKIP_BONUS=1

# --- Лабораторна 4 ---
# Ключ Gemini (GEMINI_API_KEY вище) потрібен для ембедингів НАВІТЬ якщо відповіді генерує Claude (LAB_PROVIDER=claude).
# Необов'язково: інша папка з PDF положень, завантажених вручну (за замовчуванням lab4-pdf у корені проєкту)
# LAB4_PDF_DIR=lab4-pdf
# Необов'язково: не завантажувати PDF з efund.cnu.edu.ua (лише кеш target/lab4-corpus і папка з PDF)
# LAB4_OFFLINE=1
# Бонус: BM25 з українською морфологією (UkrainianMorfologikAnalyzer) — 0 нових запитів
# LAB_BM25_MORFOLOGIK=1
# Необов'язково: скільки токенів ембедингів відправляти за хвилину. Діє лише на те, чого немає в кеші викладача
# (зазвичай — кілька ваших питань, тож студентам змінювати не треба). 0 — без обмеження.
#   безплатний тариф: 30000 (за замовчуванням, з запасом); крім того, безплатно — ≈1000 текстів ембедингів на добу,
#                     тож увесь корпус (≈2,8 тис. текстів) без кешу викладача безплатно не проіндексувати за день;
#   платний тариф (викладач, клас TeacherIndex): 300000 — так кеш зібрано 12.11.2026.
# LAB_EMBED_TPM=30000
# Необов'язково: модель ембедингів і розмір пакета batchEmbedContents (за замовчуванням gemini-embedding-2 і 100)
# LAB_EMBED_MODEL=gemini-embedding-2
# LAB_EMBED_BATCH=100

# Необов'язково: режим імітації без ключа й грошей (числа токенів — ПРИБЛИЗНІ, відповіді — шаблонні)
# LAB_MOCK=1
# Лише для MOCK: покоління імітованого Claude (5 або 4) і імітація моделі, що не приймає temperature
# LAB_MOCK_CLAUDE_GEN=4
# LAB_MOCK_NO_TEMPERATURE=1
